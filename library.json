{
  "name": "TesserKIT",
  "version": "0.1.0",
  "description": "A device framework for ESP32: Wi-Fi, Ethernet, time, firmware updates, backups, files, users, schedules, MQTT with Home Assistant discovery, Art-Net, Bluetooth, ESP-NOW, the log, the battery and deep sleep as TesserAPI subtrees, drawn by TesserUI's web interface with no UI code. Arduino and ESP-IDF.",
  "keywords": ["framework", "wifi", "captive-portal", "ota", "ntp", "web", "esp32", "tesserapi", "tesserui"],
  "repository": {
    "type": "git",
    "url": "https://github.com/leokeba/TesserKIT.git"
  },
  "authors": [{ "name": "Leo Baque", "maintainer": true }],
  "license": "MIT",
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"],
  "headers": ["TesserKIT.h"],
  "dependencies": [
    { "name": "TesserAPI", "version": "https://github.com/leokeba/TesserAPI.git#e8ef83258087aceed25e66276dbefc15f5285215" },
    { "name": "TesserUI", "version": "https://github.com/leokeba/TesserUI.git#fc29e6a8c0340271cd114d5f19d1fb6c3850ad97" }
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "flags": ["-std=gnu++17"]
  },
  "export": {
    "exclude": ["test", "build", ".github", "fixtures"]
  }
}
