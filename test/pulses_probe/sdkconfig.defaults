# As examples/idf/minimal: two OTA slots, rollback, a core dump.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions/tesserkit_4mb.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# PulseOutput: the GPTimer's interrupt and control functions in IRAM, so the
# pulses run while the flash is written (ESP-IDF 5.1 names the first
# CONFIG_GPTIMER_ISR_IRAM_SAFE).
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
CONFIG_GPTIMER_ISR_IRAM_SAFE=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
# The capture's interrupt too, so no edge is lost while the flash is written.
CONFIG_MCPWM_ISR_CACHE_SAFE=y
CONFIG_MCPWM_ISR_IRAM_SAFE=y
