# TesserKIT's partition table with a filesystem: two OTA slots, LittleFS for
# Files, a core dump.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../partitions/tesserkit_4mb_files.csv"
# A new image rolls back unless it confirms itself (/sys/firmware).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Crashes leave a core dump, downloadable at /sys/coredump.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# WebSocket for the interface's subscriptions.
CONFIG_HTTPD_WS_SUPPORT=y
# The serial API's UART drains its 128-byte FIFO from IRAM, so a flash
# write (which disables the cache) can't make it lose received bytes: seen
# on DEVKIT-V3 during a firmware upload over the serial line (2026-10-15),
# where TesserAPI now answers such a line busy/line_overrun.
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# HTTP (7 connections), DNS, downloads.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Size over debuggability, as shipped firmware is built.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Asserts without their file and line strings: about 59 KB of flash on the
# classic ESP32, which this example needs to keep room for its next update.
# A failed assert still panics with a backtrace, and the core dump's address
# gives the file and line (DESIGN.md section 11).
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# The console's UART also carries the API (the launcher's USB way): the
# launcher skips log lines, but one written in the middle of a reply breaks it.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# NimBLE, the host TesserAPI's BleTransport uses on ESP-IDF, beside Wi-Fi.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
# Buffers for notifications in flight: a long reply streams through them.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
# BleTransport is a peripheral with one client at a time: the other roles,
# the GATT client, bonding and two more connections only take RAM.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
# NimBLE's own log keeps its errors only: its info lines are compiled in
# whatever the console's level (about 9 KB of flash), and the console is at
# warnings anyway.
CONFIG_BT_NIMBLE_LOG_LEVEL_ERROR=y
# TLS (GitHub releases, downloads, mqtts://) allocates its buffers as it needs
# them and frees the certificates once verified: with Bluetooth, NowTP and
# MQTT, a handshake doesn't fit in what a classic ESP32 has left otherwise.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# RAM for TLS beside everything else: six Wi-Fi receive buffers rather than
# ten (a little less throughput under load), and the server's certificate
# dropped once verified.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# TLS as the device uses it, a client (GitHub releases, downloads, mqtts://):
# nothing in TesserKIT, TesserAPI or TesserUI serves TLS, and nothing reads
# CRLs, CSRs or PKCS#7, writes PEM, or verifies Brainpool, secp256k1 or
# secp521r1 certificates (the web's are RSA, P-256 and P-384). About 14 KB of
# flash (review of 2026-10-27).
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_PKCS7_C=n
# The station joins personal networks (open, WPA2, WPA3), not enterprise
# (802.1X) ones, which Network has no settings for.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# ESP-IDF's common CA bundle rather than the full one: the roots behind most
# of the web (DigiCert, ISRG, Sectigo, USERTrust, GlobalSign, ...), which
# GitHub's are, in 14 KB rather than 56 KB. The full set needs the room: a
# broker whose root isn't there fails its TLS handshake (the classic and psram
# profiles keep the full bundle).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# The access point is open or WPA2 (Network's fallback and provisioning):
# its WPA3 (SAE) and Enhanced Open (OWE) support is never used, and takes
# about 16 KB of flash. The station still joins WPA3 networks.
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP=n

# Ethernet without a DHCP server (a cable straight to a computer): a
# link-local address (169.254/16) while DHCP keeps asking (DESIGN.md 5.2).
CONFIG_LWIP_AUTOIP=y

# IPv4 only: every address in TesserKIT, TesserAPI and NowTP is IPv4, and
# the stack's IPv6 (ND, MLD, the link-local address and mDNS's AAAA
# answers) costs about 25 KB of flash and 1.8 KB of static RAM, plus its
# heap at run time. Needs TesserAPI b92a555 or later.
CONFIG_LWIP_IPV6=n
# NowTP's Streams: neither TesserKIT nor TesserAPI opens one (NowTP d0af51b).
CONFIG_NOWTP_NO_STREAMS=y
