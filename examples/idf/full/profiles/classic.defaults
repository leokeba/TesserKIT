# The classic profile (-DPROFILE=classic): every service but Bluetooth, for a
# classic ESP32 without PSRAM, as a node or a gateway, on Wi-Fi or Ethernet.
# Bluetooth's controller and NimBLE take about 48 KB of heap: with them, a
# Gledopto with Ethernet and every service had 12 KB free, too little for
# HTTPS or a backup, and as a gateway it fell to 92 bytes; without them it had
# 60 KB, and as a gateway 58 KB at the lowest (DESIGN.md 11, Profiles).
CONFIG_BT_ENABLED=n
CONFIG_FULL_PROFILE="classic"
# Its own memory settings (2026-10-22): with Bluetooth out, the classic ESP32
# has room for what the full example gives up. Assertions print their file and
# line again (about 59 KB of flash), and Wi-Fi gets ESP-IDF's ten receive
# buffers rather than six (about 6.4 KB of heap): more throughput under load.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
# ESP-IDF's full CA bundle (about 42 KB more than the full set's common one):
# any broker's root.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# sACN beside Art-Net (2026-10-23): the full set leaves it out for room.
CONFIG_FULL_SACN=y
